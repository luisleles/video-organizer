{
  "name": "video-organizer",
  "productName": "Video Organizer",
  "desktopName": "video-organizer.desktop",
  "version": "1.0.4",
  "description": "Organizador de vídeos desktop",
  "author": "ll",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,main,electron -c cyan,yellow,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev:electron": "wait-on tcp:5173 dist-electron/main.js dist-electron/preload.js && node scripts/start-electron.mjs --dev",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "preview": "npm run build && node scripts/start-electron.mjs",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.luisleles.videoorganizer",
    "npmRebuild": false,
    "artifactName": "video-organizer-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "video-organizer-${version}-${arch}-nsis.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Organizer",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["pt_BR", "en_US"]
    },
    "portable": {
      "artifactName": "video-organizer-${version}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "video-organizer",
      "maintainer": "Luis Leles <00luisleless@gmail.com>",
      "synopsis": "Organize vídeos e imagens de HDs externos num feed vertical",
      "syncDesktopName": true
    },
    "deb": {
      "packageCategory": "video"
    }
  }
}
